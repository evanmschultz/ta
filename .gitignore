# Binaries
/bin/*
!/bin/agent-dispatch.sh
/dist/

# Test and coverage artifacts
coverage.out
coverage.html
*.test
*.prof

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Playwright MCP cache (ephemeral browser session artifacts)
.playwright-mcp/

# Mage cache
mage_output_file.go
.mcp.json
.codex/

# Claude Code per-dev overrides; the shared baseline lives in .claude/settings.json
.claude/settings.local.json
# Ephemeral per-session lock written by Claude Code's scheduled-task /
# ScheduleWakeup mechanism. Session-PID-bound; never commit.
.claude/scheduled_tasks.lock

# Astro template substrate (web/templates_embed/) — build artifacts only;
# the embed dist dir keeps a .keep so the empty directory exists for go:embed
# before the first Astro build runs.
web/templates_embed/node_modules/
web/templates_embed/.astro/
web/templates_embed/dist/
internal/templates_html_embed/dist/*
!internal/templates_html_embed/dist/.keep
