# Binaries
/bin/*
!/bin/agent-dispatch.sh
/dist/

# Agent-dispatch per-run audit captures + gate hook debug log + pycache
# (transient veracity artifacts; regenerated every dispatch — never commit).
.claude/agent-runs/
.claude/hooks/__pycache__/
.claude/hooks/ta_gate_debug.log

# Test and coverage artifacts
coverage.out
coverage.html
*.test
*.prof

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Playwright MCP cache (ephemeral browser session artifacts)
.playwright-mcp/

# Mage cache
mage_output_file.go
.mcp.json
.codex/

# Claude Code per-dev overrides; the shared baseline lives in .claude/settings.json
.claude/settings.local.json
# Ephemeral per-session lock written by Claude Code's scheduled-task /
# ScheduleWakeup mechanism. Session-PID-bound; never commit.
.claude/scheduled_tasks.lock

# Astro template substrate (web/templates_embed/) — build artifacts only;
# the embed dist dir keeps a .keep so the empty directory exists for go:embed
# before the first Astro build runs.
web/templates_embed/node_modules/
web/templates_embed/.astro/
web/templates_embed/dist/
internal/templates_html_embed/dist/*
!internal/templates_html_embed/dist/.keep

# drop_014 visual verification screenshots (regenerate via playwright)
/drop_014-*.png

# drop_015 /flow + /kanban visual verification screenshots (regenerate via the
# /flow and /kanban skills); root-level captures, referenced by no doc.
/flow-v1*.png
/kanban-v1.png
/final-index.png

# pnpm install artifacts (CI installs fresh; commit lockfile separately if pinning desired)
/a11y/pnpm-lock.yaml

# Ephemeral sandbox/gate probe fixtures (throwaway dirs from the gatekeeping
# investigation; never commit — regenerate by re-running the probes).
/.sbx*/
/.barehook/
/.asrt*/
/.ra1/
/.ra2/
