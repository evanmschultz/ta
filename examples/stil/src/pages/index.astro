---
// L3-E3-D1 — stil view gallery (foundation index).
//
// Index page listing the 7 stil view demos. Wraps the StilLayout shell so
// the gallery itself proves the layout works end-to-end before D2/D3/D4
// land their own view pages.
//
// 7 link cards (per AMEND-2's cascade_qa split into 2 .astro files):
//   - cascade_drop
//   - cascade_planner
//   - cascade_droplet
//   - cascade_qa_proof
//   - cascade_qa_falsification
//   - roadmap_version
//   - schema_browser
//
// ZERO authored <script> elements live in this file. StilLayout itself is
// also script-free; the only inherited script surface comes from imported
// stil components (Sidebar / Topbar data-* hooks), counted against the
// parent L3-E3 close-gate.

import StilLayout from "../layouts/StilLayout.astro";

interface ViewCard {
  href: string;
  title: string;
  blurb: string;
  recordType: string;
}

const views: ReadonlyArray<ViewCard> = [
  {
    href: "/stil/cascade_drop",
    title: "cascade.drop",
    blurb:
      "L1 drop record renderer. Title, objective, acceptance_criteria, decision_log, paths list, state pill.",
    recordType: "cascade.drop",
  },
  {
    href: "/stil/cascade_planner",
    title: "cascade.planner",
    blurb:
      "Interior planner record. Objective, description, decision_log, child path map.",
    recordType: "cascade.planner",
  },
  {
    href: "/stil/cascade_droplet",
    title: "cascade.droplet",
    blurb:
      "Atomic build leaf. Paths array, irreducible flag, attempt_count, transition_notes.",
    recordType: "cascade.droplet",
  },
  {
    href: "/stil/cascade_qa_proof",
    title: "cascade.qa_proof",
    blurb:
      "QA proof record. target_id link, role=qa-proof, evidence-completeness decision_log.",
    recordType: "cascade.qa_proof",
  },
  {
    href: "/stil/cascade_qa_falsification",
    title: "cascade.qa_falsification",
    blurb:
      "QA falsification record. target_id link, role=qa-falsification, counter-example decision_log.",
    recordType: "cascade.qa_falsification",
  },
  {
    href: "/stil/roadmap_version",
    title: "roadmap.version",
    blurb:
      "Release-band version. vision_summary, status enum, target_date_band, description.",
    recordType: "roadmap.version",
  },
  {
    href: "/stil/schema_browser",
    title: "schema browser",
    blurb:
      "Schema tree. Scopes → types → fields. Mirrors the .ta/schema.toml structure with extends links.",
    recordType: "schema.browser",
  },
];
---

<StilLayout title="stil views — gallery">
  <section class="hero">
    <h1 class="hero-title">stil views, rendered from frozen fixtures.</h1>
    <p class="hero-tagline">
      Seven view pages exercising the stil component library against the
      <code>cascade.{`{drop,planner,droplet,qa_proof,qa_falsification}`}</code>,
      <code>roadmap.version</code>, and schema browser fixture shapes. All
      data frozen for deterministic build verification.
    </p>
  </section>

  <ul class="gallery" role="list">
    {views.map((view) => (
      <li class="gallery-item">
        <a class="card" href={view.href}>
          <span class="card-type">{view.recordType}</span>
          <h2 class="card-title">{view.title}</h2>
          <p class="card-blurb">{view.blurb}</p>
        </a>
      </li>
    ))}
  </ul>

  <footer class="footer">
    <span class="footer-mark">stil · ta view substrate</span>
    <span class="footer-sep">·</span>
    <span>
      fixtures: <code>src/mock/stil_records.ts</code>
    </span>
  </footer>
</StilLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
    max-width: 720px;
    margin-bottom: var(--space-6, 1.5rem);
  }

  .hero-title {
    font-family: var(--font-serif, ui-serif, Georgia, serif);
    font-size: var(--text-3xl, 1.875rem);
    font-weight: var(--weight-regular, 400);
    line-height: var(--leading-tight, 1.15);
    letter-spacing: var(--tracking-tight, -0.01em);
    color: var(--text-primary);
    margin: 0;
  }

  .hero-tagline {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed, 1.6);
    margin: 0;
  }

  .hero-tagline code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.9em;
    color: var(--text-primary);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4, 1rem);
    margin: 0 0 var(--space-6, 1.5rem) 0;
    padding: 0;
    list-style: none;
  }

  .gallery-item {
    display: contents;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-5, 1.25rem);
    background: var(--bg-surface);
    border-radius: var(--radius-3, 8px);
    color: inherit;
    text-decoration: none;
    transition: background 120ms ease, box-shadow 120ms ease;
  }

  .card:hover,
  .card:focus-visible {
    background: var(--bg-hover);
    outline: none;
  }

  .card:focus-visible {
    box-shadow: var(--focus-ring, 0 0 0 2px var(--accent, #4a90e2));
  }

  .card-type {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .card-title {
    font-family: var(--font-serif, ui-serif, Georgia, serif);
    font-size: var(--text-xl, 1.25rem);
    font-weight: var(--weight-regular, 400);
    color: var(--text-primary);
    margin: 0;
  }

  .card-blurb {
    font-size: var(--text-sm, 0.875rem);
    line-height: var(--leading-relaxed, 1.6);
    color: var(--text-secondary);
    margin: 0;
  }

  .footer {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-6, 1.5rem) 0;
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    flex-wrap: wrap;
  }

  .footer-mark {
    font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--text-secondary);
  }

  .footer-sep {
    opacity: 0.5;
  }

  .footer code {
    font-family: var(--font-mono, ui-monospace, monospace);
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: var(--text-2xl, 1.5rem);
    }
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
