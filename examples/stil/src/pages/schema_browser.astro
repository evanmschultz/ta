---
// L3-E3-D4 — schema browser view (stil).
//
// Renders the MOCK_SCHEMA_BROWSER fixture as a stil view. Consumes
// StilLayout in shell-chrome mode so Sidebar + Topbar provide the global
// navigation chrome at the layout layer (per AMEND-1 allowlist).
//
// The schema browser's structure is a 3-level hierarchy:
//
//   scope            → <section> block (named landmark per scope name)
//     type           → <article> card (ComponentCard wrapper)
//       fields       → <table> rows
//         name | type | required | default | enum | description
//
// Required / not-required is rendered as a pill:
//   required=true  → red state-error-bg pill (the on-disk schema treats
//                    missing required fields as a hard error, hence the
//                    error-bg surface — matches the gravity of the field)
//   required=false → neutral pill (chrome bg)
//
// Enum is rendered as a comma-joined chip list (one chip per enum value);
// when absent, the cell renders an em-dash.
//
// AMEND-1 component allowlist honoured: only {Sidebar, Topbar,
// ComponentCard} are imported. Sidebar + Topbar come in via StilLayout's
// chrome="shell" prop, ComponentCard is imported directly.
// FORBIDDEN components ({RightAside, MobileCommandFab, SettingsOptions,
// ThemeToggle, TokenEditor, InputStyles}) are NOT imported.
//
// All styling rides stil's --stil-* / spacing / colour CSS custom
// properties — no hard-coded palette values, no inline styles.
//
// ZERO authored client-side script elements.

import StilLayout from "../layouts/StilLayout.astro";
import ComponentCard from "@hylla/stil/src/components/ComponentCard.astro";
import {
  MOCK_SCHEMA_BROWSER,
  type SchemaFieldFixture,
} from "../mock/stil_records.ts";

const fixture = MOCK_SCHEMA_BROWSER;

interface SidebarItem {
  icon: string;
  label: string;
  selected?: boolean;
  badge?: string;
  muted?: boolean;
}

const sidebarItems: ReadonlyArray<SidebarItem> = [
  { icon: "←", label: "Gallery" },
  { icon: "◇", label: "cascade.drop", muted: true },
  { icon: "◇", label: "cascade.planner", muted: true },
  { icon: "◇", label: "cascade.droplet", muted: true },
  { icon: "◇", label: "cascade.qa_proof", muted: true },
  { icon: "◇", label: "cascade.qa_falsification", muted: true },
  { icon: "◇", label: "roadmap.version", muted: true },
  { icon: "◆", label: "schema.browser", selected: true },
];

// Counts surfaced in the page header so the at-a-glance scale is visible
// without scrolling through every scope.
const scopeCount = fixture.scopes.length;
const typeCount = fixture.scopes.reduce(
  (acc, scope) => acc + scope.types.length,
  0,
);
const fieldCount = fixture.scopes.reduce(
  (scopeAcc, scope) =>
    scopeAcc +
    scope.types.reduce((typeAcc, t) => typeAcc + t.fields.length, 0),
  0,
);

// Each scope gets a stable slug so its <section> aria-labelledby + the
// per-scope heading id can reference each other safely.
function slugify(value: string): string {
  return value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

// Render-helper: the `default` and `description` cells use em-dash when
// absent so the table grid stays aligned across all rows. Centralised so the
// substitution is auditable in one place.
const EMPTY_CELL = "—";

interface FieldRow extends SchemaFieldFixture {
  defaultValue?: string;
}

// Defensive extension: `default` is not on the SchemaFieldFixture interface
// today; pick it up via index access so a future fixture revision that adds
// it is rendered without further edits to this file.
function fieldDefault(field: SchemaFieldFixture): string {
  const candidate = (field as { default?: unknown }).default;
  if (candidate === undefined || candidate === null) {
    return EMPTY_CELL;
  }
  if (typeof candidate === "string") {
    return candidate.length > 0 ? candidate : EMPTY_CELL;
  }
  return String(candidate);
}
---

<StilLayout
  title="schema browser view — stil"
  chrome="shell"
  sidebarTitle="stil views"
  sidebarItems={sidebarItems}
  topbarTitle="schema browser"
>
  <article class="schema-view" aria-labelledby="schema-title">
    <header class="schema-header">
      <p class="schema-type">schema.browser</p>
      <h1 id="schema-title" class="schema-title">Schema browser</h1>
      <p class="schema-summary">
        Hand-curated subset of <code>.ta/schema.toml</code> — scopes,
        types, and field tables.
      </p>
      <dl class="schema-counts" aria-label="Schema shape summary">
        <div class="schema-counts-cell">
          <dt>scopes</dt>
          <dd>{scopeCount}</dd>
        </div>
        <div class="schema-counts-cell">
          <dt>types</dt>
          <dd>{typeCount}</dd>
        </div>
        <div class="schema-counts-cell">
          <dt>fields</dt>
          <dd>{fieldCount}</dd>
        </div>
      </dl>
    </header>

    {fixture.scopes.map((scope) => {
      const scopeId = `scope-${slugify(scope.name)}`;
      return (
        <section class="scope" aria-labelledby={scopeId}>
          <header class="scope-header">
            <p class="scope-kind">scope</p>
            <h2 id={scopeId} class="scope-name"><code>{scope.name}</code></h2>
            {scope.description && (
              <p class="scope-desc">{scope.description}</p>
            )}
          </header>

          <div class="scope-types">
            {scope.types.map((type) => {
              const typeRecordId = `${scope.name}.${type.name}`;
              return (
                <ComponentCard
                  id={`type-${slugify(typeRecordId)}`}
                  name={typeRecordId}
                  source={`schema.browser.scope[${scope.name}].type[${type.name}]`}
                  note={type.extends ? `extends ${type.extends}` : undefined}
                >
                  <article class="type-card" aria-labelledby={`type-name-${slugify(typeRecordId)}`}>
                    <header class="type-header">
                      <h3
                        id={`type-name-${slugify(typeRecordId)}`}
                        class="type-name"
                      >
                        <code>{type.name}</code>
                      </h3>
                      {type.extends && (
                        <p class="type-extends">
                          <span class="type-extends-label">extends</span>
                          <code>{type.extends}</code>
                        </p>
                      )}
                      {type.description && (
                        <p class="type-desc">{type.description}</p>
                      )}
                    </header>

                    {type.fields.length > 0 ? (
                      <div class="fields-wrap" role="region" aria-label={`${type.name} fields`}>
                        <table class="fields">
                          <thead>
                            <tr>
                              <th scope="col">name</th>
                              <th scope="col">type</th>
                              <th scope="col">required</th>
                              <th scope="col">default</th>
                              <th scope="col">enum</th>
                              <th scope="col">description</th>
                            </tr>
                          </thead>
                          <tbody>
                            {type.fields.map((field: FieldRow) => {
                              const isRequired = field.required === true;
                              const enumValues = field.enum ?? [];
                              return (
                                <tr>
                                  <td>
                                    <code class="field-name">{field.name}</code>
                                  </td>
                                  <td>
                                    <code class="field-type">{field.type}</code>
                                  </td>
                                  <td>
                                    <span
                                      class={`pill pill-required ${isRequired ? "pill-required--yes" : "pill-required--no"}`}
                                      aria-label={isRequired ? "required" : "optional"}
                                    >
                                      {isRequired ? "required" : "optional"}
                                    </span>
                                  </td>
                                  <td>
                                    <code class="field-default">{fieldDefault(field)}</code>
                                  </td>
                                  <td>
                                    {enumValues.length > 0 ? (
                                      <ul class="enum-list" role="list">
                                        {enumValues.map((value, idx) => (
                                          <li class="enum-chip">
                                            <code>{value}</code>
                                            {idx < enumValues.length - 1 && (
                                              <span class="enum-sep" aria-hidden="true">,</span>
                                            )}
                                          </li>
                                        ))}
                                      </ul>
                                    ) : (
                                      <span class="field-empty">{EMPTY_CELL}</span>
                                    )}
                                  </td>
                                  <td class="field-desc-cell">
                                    {field.description ? (
                                      <span class="field-desc">{field.description}</span>
                                    ) : (
                                      <span class="field-empty">{EMPTY_CELL}</span>
                                    )}
                                  </td>
                                </tr>
                              );
                            })}
                          </tbody>
                        </table>
                      </div>
                    ) : (
                      <p class="type-empty">No fields documented on this type.</p>
                    )}
                  </article>
                </ComponentCard>
              );
            })}
          </div>
        </section>
      );
    })}
  </article>
</StilLayout>

<style>
  .schema-view {
    display: flex;
    flex-direction: column;
    gap: var(--space-7, 1.75rem);
    max-width: 1080px;
  }

  .schema-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .schema-type {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .schema-title {
    font-family: var(--font-serif, ui-serif, Georgia, serif);
    font-size: var(--text-3xl, 1.875rem);
    font-weight: var(--weight-regular, 400);
    line-height: var(--leading-tight, 1.15);
    letter-spacing: var(--tracking-tight, -0.01em);
    color: var(--text-primary);
    margin: 0;
  }

  .schema-summary {
    margin: 0;
    color: var(--text-secondary);
    line-height: var(--leading-relaxed, 1.6);
  }

  .schema-summary code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.9em;
    color: var(--text-primary);
  }

  .schema-counts {
    display: flex;
    gap: var(--space-5, 1.25rem);
    flex-wrap: wrap;
    margin: var(--space-2, 0.5rem) 0 0 0;
    padding: 0;
  }

  .schema-counts-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-1, 0.25rem);
  }

  .schema-counts-cell dt {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .schema-counts-cell dd {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-lg, 1.125rem);
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .scope {
    display: flex;
    flex-direction: column;
    gap: var(--space-5, 1.25rem);
    padding: var(--space-5, 1.25rem);
    background: var(--bg-surface);
    border-radius: var(--radius-3, 8px);
  }

  .scope-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .scope-kind {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
  }

  .scope-name {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xl, 1.25rem);
    font-weight: var(--weight-medium, 500);
    color: var(--text-primary);
  }

  .scope-desc {
    margin: 0;
    color: var(--text-secondary);
    line-height: var(--leading-relaxed, 1.6);
  }

  .scope-types {
    display: flex;
    flex-direction: column;
    gap: var(--space-5, 1.25rem);
  }

  .type-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
  }

  .type-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1, 0.25rem);
  }

  .type-name {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-lg, 1.125rem);
    font-weight: var(--weight-medium, 500);
    color: var(--text-primary);
  }

  .type-extends {
    margin: 0;
    display: flex;
    gap: var(--space-2, 0.5rem);
    align-items: baseline;
    color: var(--text-secondary);
    font-size: var(--text-sm, 0.875rem);
  }

  .type-extends-label {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .type-desc {
    margin: 0;
    color: var(--text-secondary);
    line-height: var(--leading-relaxed, 1.6);
  }

  .type-empty {
    margin: 0;
    color: var(--text-tertiary);
    font-style: italic;
  }

  .fields-wrap {
    overflow-x: auto;
    border-radius: var(--radius-2, 4px);
    background: var(--bg-canvas, transparent);
  }

  .fields {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm, 0.875rem);
  }

  .fields thead th {
    text-align: left;
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    border-bottom: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.08));
    font-weight: var(--weight-medium, 500);
  }

  .fields tbody td {
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    vertical-align: top;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle, rgba(0, 0, 0, 0.04));
  }

  .fields tbody tr:last-child td {
    border-bottom: none;
  }

  .field-name,
  .field-type,
  .field-default {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-sm, 0.875rem);
  }

  .field-desc-cell {
    min-width: 240px;
  }

  .field-desc {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed, 1.6);
  }

  .field-empty {
    color: var(--text-tertiary);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-2, 0.5rem);
    height: 1.4em;
    border-radius: var(--radius-2, 4px);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    font-weight: var(--weight-medium, 500);
    background: var(--bg-chrome, var(--bg-hover));
    color: var(--text-primary);
  }

  .pill-required--yes {
    background: var(--state-error-bg, var(--bg-hover));
    color: var(--state-error-text, var(--text-primary));
  }

  .pill-required--no {
    background: var(--bg-chrome, var(--bg-hover));
    color: var(--text-secondary);
  }

  .enum-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-1, 0.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: baseline;
  }

  .enum-chip {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1, 0.25rem);
  }

  .enum-chip code {
    background: var(--bg-chrome, var(--bg-hover));
    border-radius: var(--radius-2, 4px);
    padding: 0 var(--space-2, 0.5rem);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-primary);
  }

  .enum-sep {
    color: var(--text-tertiary);
  }

  @media (max-width: 640px) {
    .schema-title {
      font-size: var(--text-2xl, 1.5rem);
    }
    .schema-counts {
      gap: var(--space-3, 0.75rem);
    }
  }
</style>
