---
// L3-E4-D4 — Thariq droplet kanban demo.
//
// Four-column kanban (todo / in_progress / complete / failed) over the
// MOCK_DROPLETS fixture set. CSS Grid lays out four equal columns at
// desktop; a @container query collapses to a single column below 768px.
//
// ZERO new <script> elements live in this file. The two scripts that
// appear in the dist output are inherited from @hylla/stil's Playground
// layout (theme persistence + chrome shortcuts) and are counted against
// the parent close-gate, not this droplet.
//
// Stil components used (≥3 distinct):
//   - Playground   (layout — theme tokens + fonts)
//   - Sidebar      (app-shell chrome)
//   - Topbar       (app-shell chrome)
//   - ComponentCard (card-like surface for each droplet)

import Playground from "@hylla/stil/src/layouts/Playground.astro";
import Sidebar from "@hylla/stil/src/components/Sidebar.astro";
import Topbar from "@hylla/stil/src/components/Topbar.astro";
import ComponentCard from "@hylla/stil/src/components/ComponentCard.astro";
import {
  MOCK_DROPLETS,
  type CascadeDroplet,
  type CascadeState,
} from "../../mock/thariq_records.ts";

type KanbanState = Extract<
  CascadeState,
  "todo" | "in_progress" | "complete" | "failed"
>;

interface Column {
  state: KanbanState;
  label: string;
  items: ReadonlyArray<CascadeDroplet>;
}

// Partition MOCK_DROPLETS by state. Order is the canonical kanban flow.
const columnOrder: ReadonlyArray<{ state: KanbanState; label: string }> = [
  { state: "todo", label: "Todo" },
  { state: "in_progress", label: "In progress" },
  { state: "complete", label: "Complete" },
  { state: "failed", label: "Failed" },
];

const columns: ReadonlyArray<Column> = columnOrder.map(({ state, label }) => ({
  state,
  label,
  items: MOCK_DROPLETS.filter((d) => d.state === state),
}));

const sidebarItems = [
  { icon: "✦", label: "Thariq demos" },
  { icon: "❀", label: "Cascade records" },
  { icon: "◇", label: "Droplet kanban", selected: true },
  { icon: "⌗", label: "Testdata" },
];

// Derive a short id slug from the full record id (last segment after the
// final dot). Keeps each ComponentCard's id under a sane render width.
function shortId(fullId: string): string {
  const parts = fullId.split(".");
  return parts[parts.length - 1] ?? fullId;
}
---

<Playground title="Droplet kanban — thariq demos">
  <div class="app">
    <div class="app-sidebar">
      <Sidebar title="Thariq" items={sidebarItems} />
    </div>

    <main class="app-main">
      <Topbar title="Droplet kanban — thariq demos" />

      <div class="app-main-body">
        <header class="page-header">
          <h1 class="page-title">Droplet kanban</h1>
          <p class="page-tagline">
            <code>MOCK_DROPLETS</code> partitioned by <code>state</code>.
            Four columns at desktop; collapses to one column below 768px
            via <code>@container</code>.
          </p>
        </header>

        <div class="kanban">
          {columns.map((column) => (
            <section
              class="kanban-column"
              aria-label={`${column.state} column`}
            >
              <header class="kanban-column-header">
                <h2 class="kanban-column-title">{column.label}</h2>
                <span class="kanban-column-count">{column.items.length}</span>
              </header>

              <ul class="kanban-list" role="list">
                {column.items.map((droplet) => (
                  <li class="kanban-item">
                    <ComponentCard
                      id={shortId(droplet.id)}
                      name={droplet.title}
                      source={droplet.paths?.[0] ?? droplet.id}
                      note={droplet.objective}
                    >
                      <dl class="droplet-meta">
                        <div class="droplet-meta-row">
                          <dt>role</dt>
                          <dd>{droplet.role}</dd>
                        </div>
                        {droplet.irreducible && (
                          <div class="droplet-meta-row">
                            <dt>irreducible</dt>
                            <dd>
                              <span class="droplet-flag">true</span>
                            </dd>
                          </div>
                        )}
                        {droplet.paths && droplet.paths.length > 0 && (
                          <div class="droplet-meta-row">
                            <dt>paths</dt>
                            <dd>
                              <ul class="droplet-paths" role="list">
                                {droplet.paths.slice(0, 2).map((p) => (
                                  <li><code>{p}</code></li>
                                ))}
                              </ul>
                            </dd>
                          </div>
                        )}
                      </dl>
                    </ComponentCard>
                  </li>
                ))}
                {column.items.length === 0 && (
                  <li class="kanban-empty">No droplets in this state.</li>
                )}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </main>
  </div>
</Playground>

<style>
  .app {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 100vh;
    background: var(--bg-app);
    color: var(--text-primary);
    font-family: var(--font-sans);
  }

  .app-sidebar {
    height: 100vh;
    position: sticky;
    top: 0;
  }

  .app-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .app-main-body {
    /* Establish a containment context so child @container queries
     * resolve against the main column width, not the viewport. */
    container-type: inline-size;
    container-name: kanban;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 640px;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: 0;
  }

  .page-tagline {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .page-tagline code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text-primary);
  }

  .kanban {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    align-items: start;
  }

  .kanban-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--bg-surface);
    border-radius: var(--radius-3);
    min-width: 0;
  }

  .kanban-column-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: 0 var(--space-2);
  }

  .kanban-column-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-regular);
    color: var(--text-primary);
    margin: 0;
  }

  .kanban-column-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .kanban-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kanban-item {
    display: block;
  }

  .kanban-empty {
    padding: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    font-style: italic;
    text-align: center;
  }

  .droplet-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }

  .droplet-meta-row {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--space-2);
    align-items: baseline;
    font-size: var(--text-xs);
  }

  .droplet-meta-row dt {
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .droplet-meta-row dd {
    color: var(--text-secondary);
    margin: 0;
    min-width: 0;
    word-break: break-word;
  }

  .droplet-flag {
    display: inline-block;
    padding: 1px var(--space-2);
    background: var(--accent-soft);
    color: var(--accent-pressed);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border-radius: var(--radius-1);
  }

  .droplet-paths {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .droplet-paths code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    word-break: break-all;
  }

  /* Container-query collapse: when the kanban container narrows below
   * 768px, stack columns vertically. Uses the named container established
   * on .app-main-body. */
  @container kanban (max-width: 768px) {
    .kanban {
      grid-template-columns: 1fr;
    }
  }

  /* Viewport-narrow fallback for the app-shell chrome — collapses the
   * sidebar so the kanban gets the full viewport width. */
  @media (max-width: 880px) {
    .app {
      grid-template-columns: 1fr;
    }

    .app-sidebar {
      display: none;
    }
  }
</style>
