---
// L3-E4-D1 — Thariq demo gallery (foundation).
//
// Index page listing the four cascade-record demos. Wrapped in stil's
// Playground layout for full theme + chrome. Sidebar + Topbar are imported
// to validate the @hylla/stil import path resolution before D2..D5a stack
// on top.
//
// ZERO new <script> elements live in this file. Playground brings its own
// theme + chrome scripts (already counted against the parent close-gate).

import Playground from "@hylla/stil/src/layouts/Playground.astro";
import Sidebar from "@hylla/stil/src/components/Sidebar.astro";
import Topbar from "@hylla/stil/src/components/Topbar.astro";

interface DemoCard {
  href: string;
  title: string;
  blurb: string;
  state: string;
}

const demos: ReadonlyArray<DemoCard> = [
  {
    href: "/drop-dashboard",
    title: "Drop dashboard",
    blurb:
      "App-shell view rendering a cascade.drop with its descendants as a MailRow list. Exercises Sidebar + NavRail + Topbar + MailRow + BottomTabs.",
    state: "planned · D2",
  },
  {
    href: "/planner-detail",
    title: "Planner detail",
    blurb:
      "ComponentCard rendering a cascade.planner — objective, description, decision_log. State pill via Swatch.",
    state: "planned · D3",
  },
  {
    href: "/droplet-kanban",
    title: "Droplet kanban",
    blurb:
      "Four-column kanban (todo / in_progress / complete / failed) over the cascade.droplet fixture set. CSS grid with container-query collapse.",
    state: "planned · D4",
  },
  {
    href: "/qa-twins",
    title: "QA twins",
    blurb:
      "qa_proof and qa_falsification side-by-side. Two-column grid above 768px; stacks below.",
    state: "planned · D5a",
  },
];

const sidebarItems = [
  { icon: "✦", label: "Thariq demos", selected: true },
  { icon: "❀", label: "Cascade records" },
  { icon: "◇", label: "Mock fixtures" },
  { icon: "⌗", label: "Testdata" },
];
---

<Playground title="Thariq demos — ta cascade-record gallery">
  <div class="app" data-app-shell>
    <div class="app-sidebar">
      <Sidebar items={sidebarItems} />
    </div>

    <main class="app-main">
      <Topbar title="Thariq demos — ta cascade-record gallery" />

      <div class="app-main-body">
        <div class="app-content">
          <section class="hero">
            <h1 class="hero-title">Cascade records, rendered with stil.</h1>
            <p class="hero-tagline">
              Four demo pages exercising the stil component library against the
              <code>cascade.&#123;drop,planner,droplet,qa_proof,qa_falsification&#125;</code>
              fixture shape. All data frozen for deterministic VHS capture.
            </p>
          </section>

          <ul class="gallery" role="list">
            {demos.map((demo) => (
              <li class="gallery-item">
                <a class="card" href={demo.href}>
                  <span class="card-state">{demo.state}</span>
                  <h2 class="card-title">{demo.title}</h2>
                  <p class="card-blurb">{demo.blurb}</p>
                </a>
              </li>
            ))}
          </ul>

          <footer class="footer">
            <span class="footer-mark">thariq · ta cascade demos</span>
            <span class="footer-sep">·</span>
            <span>fixtures: <code>src/mock/thariq_records.ts</code></span>
          </footer>
        </div>
      </div>
    </main>
  </div>
</Playground>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 640px;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
  }

  .hero-tagline {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .hero-tagline code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text-primary);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery-item {
    display: contents;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--bg-surface);
    border-radius: var(--radius-3);
    color: inherit;
    text-decoration: none;
    transition: background 120ms ease;
  }

  .card:hover,
  .card:focus-visible {
    background: var(--bg-hover);
    outline: none;
  }

  .card:focus-visible {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .card-state {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--weight-regular);
    color: var(--text-primary);
    margin: 0;
  }

  .card-blurb {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
    margin: 0;
  }

  .footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-6) 0;
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    flex-wrap: wrap;
  }

  .footer-mark {
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  .footer-sep {
    opacity: 0.5;
  }

  .footer code {
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: var(--text-2xl);
    }

    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
