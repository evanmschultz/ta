---
// L3-E4-D3 — Thariq demo: planner detail.
//
// Renders MOCK_PLANNERS[0] (a cascade.planner record) using stil components:
//   - Playground (layout)  — theme + chrome + token editor
//   - Sidebar              — left rail nav
//   - ComponentCard        — frame around the record body
//   - Swatch               — state pill (color = state token)
//   - Button               — back-link wrapped in <a> (Button has no href prop)
//
// Component count: Sidebar + ComponentCard + Swatch + Button = 4 (>= L3-E4 gate).
//
// ZERO new <script> elements live in this file. Playground brings its own
// theme + chrome scripts (already counted against the L3-E4 parent close-gate).

import Playground from "@hylla/stil/src/layouts/Playground.astro";
import Sidebar from "@hylla/stil/src/components/Sidebar.astro";
import ComponentCard from "@hylla/stil/src/components/ComponentCard.astro";
import Swatch from "@hylla/stil/src/components/Swatch.astro";
import Button from "@hylla/stil/src/components/Button.astro";
import {
  MOCK_PLANNERS,
  type CascadeState,
} from "../mock/thariq_records.ts";

const planner = MOCK_PLANNERS[0];

// State → hex mapping for the Swatch state pill.
// stil has no semantic success/danger tokens (only --accent), so we pick
// brand-coherent muted hues alongside the carl accent.
//   todo         → neutral grey (matches text-tertiary dark)
//   in_progress  → carl/accent (#dd9f57)
//   complete     → muted green
//   failed       → muted red
const STATE_HEX: Record<CascadeState, string> = {
  todo: "#8c8f99",
  in_progress: "#dd9f57",
  complete: "#5a8f5d",
  failed: "#b85a4e",
  archived: "#6e7280",
};

const STATE_NOTE: Record<CascadeState, string> = {
  todo: "neutral",
  in_progress: "accent",
  complete: "success",
  failed: "danger",
  archived: "muted",
};

const sidebarItems = [
  { icon: "✦", label: "Thariq demos" },
  { icon: "❀", label: "Planner detail", selected: true },
  { icon: "◇", label: "Mock fixtures" },
  { icon: "⌗", label: "Testdata" },
];

const stateHex = STATE_HEX[planner.state];
const stateNote = STATE_NOTE[planner.state];
---

<Playground title="Planner detail — thariq demos">
  <div class="app" data-app-shell>
    <div class="app-sidebar">
      <Sidebar title="Cascade demos" items={sidebarItems} />
    </div>

    <main class="app-main">
      <div class="app-main-body">
        <div class="app-content">
          <header class="detail-header">
            <div class="detail-back">
              <a href="/thariq/" class="detail-back-link">
                <Button variant="ghost" size="sm">← Back to gallery</Button>
              </a>
            </div>

            <div class="detail-title-row">
              <h1 class="detail-title">{planner.title}</h1>
              <div class="detail-state-pill" aria-label={`State: ${planner.state}`}>
                <Swatch
                  name={planner.state}
                  hex={stateHex}
                  note={stateNote}
                />
              </div>
            </div>

            <p class="detail-id"><code>{planner.id}</code></p>
          </header>

          <ComponentCard
            id="P1"
            name="cascade.planner detail"
            source="src/mock/thariq_records.ts · MOCK_PLANNERS[0]"
            note="Single planner record rendered against the stil ComponentCard frame. All ActionItem-base + planner-specific fields shown."
          >
            <article class="planner">
              <section class="planner-section" aria-labelledby="planner-objective">
                <h2 id="planner-objective" class="planner-heading">Objective</h2>
                <p class="planner-body">{planner.objective}</p>
              </section>

              <section class="planner-section" aria-labelledby="planner-description">
                <h2 id="planner-description" class="planner-heading">Description</h2>
                <p class="planner-body">{planner.description}</p>
              </section>

              <section class="planner-section" aria-labelledby="planner-meta">
                <h2 id="planner-meta" class="planner-heading">Meta</h2>
                <dl class="planner-meta">
                  <dt>Role</dt>
                  <dd><code>{planner.role}</code></dd>
                  <dt>Structural type</dt>
                  <dd><code>{planner.structural_type ?? "—"}</code></dd>
                  <dt>State</dt>
                  <dd><code>{planner.state}</code></dd>
                  <dt>Outcome</dt>
                  <dd><code>{planner.outcome || "—"}</code></dd>
                  <dt>Priority</dt>
                  <dd><code>{planner.priority ?? "—"}</code></dd>
                  <dt>Parent</dt>
                  <dd><code>{planner.parent_id ?? "—"}</code></dd>
                  <dt>Created</dt>
                  <dd><time datetime={planner.created_at}>{planner.created_at}</time></dd>
                  <dt>Updated</dt>
                  <dd><time datetime={planner.updated_at}>{planner.updated_at}</time></dd>
                  <dt>Started</dt>
                  <dd>
                    {planner.started_at
                      ? <time datetime={planner.started_at}>{planner.started_at}</time>
                      : <span class="planner-empty">—</span>}
                  </dd>
                  <dt>Completed</dt>
                  <dd>
                    {planner.completed_at
                      ? <time datetime={planner.completed_at}>{planner.completed_at}</time>
                      : <span class="planner-empty">—</span>}
                  </dd>
                </dl>
              </section>

              {planner.paths && planner.paths.length > 0 && (
                <section class="planner-section" aria-labelledby="planner-paths">
                  <h2 id="planner-paths" class="planner-heading">Paths</h2>
                  <ul class="planner-paths">
                    {planner.paths.map((p) => (
                      <li><code>{p}</code></li>
                    ))}
                  </ul>
                </section>
              )}

              {planner.acceptance_criteria && (
                <section class="planner-section" aria-labelledby="planner-acceptance">
                  <h2 id="planner-acceptance" class="planner-heading">Acceptance criteria</h2>
                  <p class="planner-body planner-acceptance">{planner.acceptance_criteria}</p>
                </section>
              )}

              {planner.labels && planner.labels.length > 0 && (
                <section class="planner-section" aria-labelledby="planner-labels">
                  <h2 id="planner-labels" class="planner-heading">Labels</h2>
                  <ul class="planner-labels" role="list">
                    {planner.labels.map((label) => (
                      <li class="planner-label">{label}</li>
                    ))}
                  </ul>
                </section>
              )}

              <section class="planner-section" aria-labelledby="planner-decisions">
                <h2 id="planner-decisions" class="planner-heading">Decision log</h2>
                {planner.decision_log && planner.decision_log.length > 0 ? (
                  <ol class="planner-decisions">
                    {planner.decision_log.map((entry) => (
                      <li class="planner-decision">{entry}</li>
                    ))}
                  </ol>
                ) : (
                  <p class="planner-empty">No decisions logged.</p>
                )}
              </section>
            </article>
          </ComponentCard>
        </div>
      </div>
    </main>
  </div>
</Playground>

<style>
  .detail-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .detail-back-link {
    display: inline-block;
    text-decoration: none;
    color: inherit;
  }

  .detail-back-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-2);
  }

  .detail-title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .detail-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: 0;
    flex: 1 1 auto;
    min-width: 0;
  }

  .detail-state-pill {
    flex: 0 0 auto;
  }

  .detail-id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    margin: 0;
  }

  .detail-id code {
    font-family: inherit;
  }

  .planner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .planner-heading {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
    letter-spacing: var(--tracking-tight);
  }

  .planner-body {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .planner-acceptance {
    white-space: pre-wrap;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .planner-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }

  .planner-meta dt {
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    align-self: center;
  }

  .planner-meta dd {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--text-sm);
  }

  .planner-meta code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .planner-meta time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .planner-paths {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .planner-paths code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .planner-labels {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .planner-label {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--bg-chrome);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .planner-decisions {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--text-secondary);
  }

  .planner-decision {
    line-height: var(--leading-relaxed);
  }

  .planner-empty {
    color: var(--text-tertiary);
    font-style: italic;
    font-size: var(--text-sm);
  }

  @container (max-width: 640px) {
    .detail-title {
      font-size: var(--text-2xl);
    }

    .planner-meta {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .planner-meta dt {
      margin-top: var(--space-2);
    }
  }

  @media (max-width: 640px) {
    .detail-title {
      font-size: var(--text-2xl);
    }

    .planner-meta {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
