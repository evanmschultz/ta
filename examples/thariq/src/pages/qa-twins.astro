---
// L3-E4-D5a — Thariq QA twins demo (final L3-E4 aggregator page).
//
// Renders MOCK_QA_PROOF + MOCK_QA_FALSIFICATION side-by-side. CSS Grid
// lays out two equal columns at desktop; an @container query collapses
// the layout to a single column below 768px.
//
// Stil components used (>=3 distinct, allowed-set only per parent AMEND):
//   - Playground    (layout — theme tokens + fonts)
//   - Sidebar       (app-shell chrome)
//   - Topbar        (app-shell chrome)
//   - ComponentCard (per-pane card frame)
//
// FORBIDDEN per L3-E4 parent AMEND (carry stil-side <script> tags that
// inflate the dist script-tag budget beyond the inherited Playground
// chrome): RightAside, MobileCommandFab, SettingsOptions, ThemeToggle,
// TokenEditor, InputStyles.
//
// ZERO new authored <script> elements in this file. Theme + chrome
// scripts that surface in dist trace to Playground, NOT to this file.

import Playground from "@hylla/stil/src/layouts/Playground.astro";
import Sidebar from "@hylla/stil/src/components/Sidebar.astro";
import Topbar from "@hylla/stil/src/components/Topbar.astro";
import ComponentCard from "@hylla/stil/src/components/ComponentCard.astro";
import {
  MOCK_QA_PROOF,
  MOCK_QA_FALSIFICATION,
} from "../mock/thariq_records.ts";

const sidebarItems = [
  { icon: "✦", label: "Thariq demos" },
  { icon: "❀", label: "Cascade records" },
  { icon: "◇", label: "Mock fixtures" },
  { icon: "⌗", label: "QA twins", selected: true },
];

// Derive a short id slug from the full record id (last segment after the
// final dot). Keeps each ComponentCard's id under a sane render width.
function shortId(fullId: string): string {
  const parts = fullId.split(".");
  return parts[parts.length - 1] ?? fullId;
}
---

<Playground title="QA twins — thariq demos">
  <div class="app" data-app-shell>
    <div class="app-sidebar">
      <Sidebar title="Thariq" items={sidebarItems} />
    </div>

    <main class="app-main">
      <Topbar title="QA twins — thariq demos" />

      <div class="app-main-body">
        <header class="page-header">
          <p class="back-link">
            <a href="/thariq/">← back to thariq demos</a>
          </p>
          <h1 class="page-title">QA twins</h1>
          <p class="page-tagline">
            <code>MOCK_QA_PROOF</code> + <code>MOCK_QA_FALSIFICATION</code>
            rendered side-by-side. Two-column grid at desktop; collapses to a
            single column below 768px via <code>@container</code>.
          </p>
        </header>

        <div class="twins">
          <section class="twins-pane" aria-label="qa-proof pane">
            <ComponentCard
              id={shortId(MOCK_QA_PROOF.id)}
              name={MOCK_QA_PROOF.title}
              source={`src/mock/thariq_records.ts · MOCK_QA_PROOF (role: ${MOCK_QA_PROOF.role})`}
              note={MOCK_QA_PROOF.objective}
            >
              <article class="qa">
                <header class="qa-head">
                  <span class="qa-role qa-role-proof">{MOCK_QA_PROOF.role}</span>
                  <span class="qa-state">{MOCK_QA_PROOF.state}</span>
                  {MOCK_QA_PROOF.outcome && (
                    <span class="qa-outcome">{MOCK_QA_PROOF.outcome}</span>
                  )}
                </header>

                <section class="qa-section" aria-labelledby="qa-proof-target">
                  <h2 id="qa-proof-target" class="qa-heading">Target</h2>
                  <p class="qa-id"><code>{MOCK_QA_PROOF.target_id}</code></p>
                </section>

                {MOCK_QA_PROOF.description && (
                  <section class="qa-section" aria-labelledby="qa-proof-description">
                    <h2 id="qa-proof-description" class="qa-heading">Description</h2>
                    <p class="qa-body">{MOCK_QA_PROOF.description}</p>
                  </section>
                )}

                <section class="qa-section" aria-labelledby="qa-proof-meta">
                  <h2 id="qa-proof-meta" class="qa-heading">Meta</h2>
                  <dl class="qa-meta">
                    <dt>Created</dt>
                    <dd>
                      <time datetime={MOCK_QA_PROOF.created_at}>
                        {MOCK_QA_PROOF.created_at}
                      </time>
                    </dd>
                    <dt>Updated</dt>
                    <dd>
                      <time datetime={MOCK_QA_PROOF.updated_at}>
                        {MOCK_QA_PROOF.updated_at}
                      </time>
                    </dd>
                    {MOCK_QA_PROOF.completed_at && (
                      <>
                        <dt>Completed</dt>
                        <dd>
                          <time datetime={MOCK_QA_PROOF.completed_at}>
                            {MOCK_QA_PROOF.completed_at}
                          </time>
                        </dd>
                      </>
                    )}
                  </dl>
                </section>

                {MOCK_QA_PROOF.decision_log && MOCK_QA_PROOF.decision_log.length > 0 && (
                  <section class="qa-section" aria-labelledby="qa-proof-decisions">
                    <h2 id="qa-proof-decisions" class="qa-heading">Decision log</h2>
                    <ol class="qa-decisions">
                      {MOCK_QA_PROOF.decision_log.map((entry) => (
                        <li class="qa-decision">{entry}</li>
                      ))}
                    </ol>
                  </section>
                )}
              </article>
            </ComponentCard>
          </section>

          <section class="twins-pane" aria-label="qa-falsification pane">
            <ComponentCard
              id={shortId(MOCK_QA_FALSIFICATION.id)}
              name={MOCK_QA_FALSIFICATION.title}
              source={`src/mock/thariq_records.ts · MOCK_QA_FALSIFICATION (role: ${MOCK_QA_FALSIFICATION.role})`}
              note={MOCK_QA_FALSIFICATION.objective}
            >
              <article class="qa">
                <header class="qa-head">
                  <span class="qa-role qa-role-falsif">{MOCK_QA_FALSIFICATION.role}</span>
                  <span class="qa-state">{MOCK_QA_FALSIFICATION.state}</span>
                  {MOCK_QA_FALSIFICATION.outcome && (
                    <span class="qa-outcome">{MOCK_QA_FALSIFICATION.outcome}</span>
                  )}
                </header>

                <section class="qa-section" aria-labelledby="qa-falsif-target">
                  <h2 id="qa-falsif-target" class="qa-heading">Target</h2>
                  <p class="qa-id"><code>{MOCK_QA_FALSIFICATION.target_id}</code></p>
                </section>

                {MOCK_QA_FALSIFICATION.description && (
                  <section class="qa-section" aria-labelledby="qa-falsif-description">
                    <h2 id="qa-falsif-description" class="qa-heading">Description</h2>
                    <p class="qa-body">{MOCK_QA_FALSIFICATION.description}</p>
                  </section>
                )}

                <section class="qa-section" aria-labelledby="qa-falsif-meta">
                  <h2 id="qa-falsif-meta" class="qa-heading">Meta</h2>
                  <dl class="qa-meta">
                    <dt>Created</dt>
                    <dd>
                      <time datetime={MOCK_QA_FALSIFICATION.created_at}>
                        {MOCK_QA_FALSIFICATION.created_at}
                      </time>
                    </dd>
                    <dt>Updated</dt>
                    <dd>
                      <time datetime={MOCK_QA_FALSIFICATION.updated_at}>
                        {MOCK_QA_FALSIFICATION.updated_at}
                      </time>
                    </dd>
                    {MOCK_QA_FALSIFICATION.completed_at && (
                      <>
                        <dt>Completed</dt>
                        <dd>
                          <time datetime={MOCK_QA_FALSIFICATION.completed_at}>
                            {MOCK_QA_FALSIFICATION.completed_at}
                          </time>
                        </dd>
                      </>
                    )}
                  </dl>
                </section>

                {MOCK_QA_FALSIFICATION.decision_log && MOCK_QA_FALSIFICATION.decision_log.length > 0 && (
                  <section class="qa-section" aria-labelledby="qa-falsif-decisions">
                    <h2 id="qa-falsif-decisions" class="qa-heading">Decision log</h2>
                    <ol class="qa-decisions">
                      {MOCK_QA_FALSIFICATION.decision_log.map((entry) => (
                        <li class="qa-decision">{entry}</li>
                      ))}
                    </ol>
                  </section>
                )}
              </article>
            </ComponentCard>
          </section>
        </div>
      </div>
    </main>
  </div>
</Playground>

<style>
  .app {
    display: grid;
    grid-template-columns: 240px 1fr;
    min-height: 100vh;
    background: var(--bg-app);
    color: var(--text-primary);
    font-family: var(--font-sans);
  }

  .app-sidebar {
    height: 100vh;
    position: sticky;
    top: 0;
  }

  .app-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .app-main-body {
    /* Establish a containment context so the .twins grid resolves its
     * @container query against the main column width, not the viewport. */
    container-type: inline-size;
    container-name: twins;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .page-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 720px;
  }

  .back-link {
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
  }

  .back-link a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .back-link a:hover,
  .back-link a:focus-visible {
    color: var(--text-primary);
    text-decoration: underline;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--text-primary);
    margin: 0;
  }

  .page-tagline {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .page-tagline code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text-primary);
  }

  .twins {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .twins-pane {
    min-width: 0;
  }

  .qa {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .qa-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }

  .qa-role {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    text-transform: lowercase;
    letter-spacing: 0.04em;
  }

  .qa-role-proof {
    background: var(--bg-chrome);
    color: var(--text-primary);
  }

  .qa-role-falsif {
    background: var(--accent-soft);
    color: var(--accent-pressed);
  }

  .qa-state,
  .qa-outcome {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .qa-heading {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    color: var(--text-primary);
    margin: 0 0 var(--space-2);
    letter-spacing: var(--tracking-tight);
  }

  .qa-body {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  .qa-id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    margin: 0;
    word-break: break-all;
  }

  .qa-id code {
    font-family: inherit;
    color: var(--text-secondary);
  }

  .qa-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
  }

  .qa-meta dt {
    color: var(--text-tertiary);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    align-self: center;
  }

  .qa-meta dd {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--text-sm);
  }

  .qa-meta time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .qa-decisions {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--text-secondary);
  }

  .qa-decision {
    line-height: var(--leading-relaxed);
  }

  /* Container-query collapse: when the twins container narrows below
   * 768px, stack panes vertically. Uses the named container established
   * on .app-main-body. */
  @container twins (max-width: 768px) {
    .twins {
      grid-template-columns: 1fr;
    }

    .qa-meta {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }

    .qa-meta dt {
      margin-top: var(--space-2);
    }
  }

  /* Viewport-narrow fallback for the app-shell chrome — collapse the
   * sidebar so the twins panes get the full viewport width. */
  @media (max-width: 880px) {
    .app {
      grid-template-columns: 1fr;
    }

    .app-sidebar {
      display: none;
    }
  }
</style>
