<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Schema Browser — Schema</title>
<style>
   

  @layer tokens, base, layout, components, utilities;

  @layer tokens {
    :root {
      --carl: #dd9f57;
      --carl-hover: #e3a868;
      --carl-pressed: #d39243;
      --carl-soft: rgb(221 159 87 / 0.14);

      --accent: var(--carl);
      --accent-hover: var(--carl-hover);
      --accent-pressed: var(--carl-pressed);
      --accent-soft: var(--carl-soft);

      --space-1: 0.25rem;
      --space-2: 0.5rem;
      --space-3: 0.75rem;
      --space-4: 1rem;
      --space-5: 1.25rem;
      --space-6: 1.5rem;
      --space-8: 2rem;
      --space-10: 2.5rem;
      --space-12: 3rem;

      --radius-1: 2px;
      --radius-2: 5px;
      --radius-3: 8px;
      --radius-4: 10px;
      --radius-pill: 9999px;
      --corner-radius: var(--radius-4);

      --font-sans: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", system-ui, sans-serif;
      --font-serif: ui-serif, "Charter", "Source Serif 4", "Iowan Old Style", Georgia, serif;
      --font-mono: "Iosevka Web", "Iosevka", "JetBrains Mono", ui-monospace, "SF Mono", Menlo, Monaco, "Cascadia Code", Consolas, monospace;

      --text-xs: 0.75rem;
      --text-sm: 0.875rem;
      --text-base: 1rem;
      --text-lg: 1.125rem;
      --text-xl: 1.375rem;
      --text-2xl: 1.75rem;
      --text-3xl: 2.25rem;

      --leading-tight: 1.2;
      --leading-snug: 1.35;
      --leading-normal: 1.55;
      --leading-relaxed: 1.7;

      --weight-regular: 400;
      --weight-medium: 500;
      --weight-semibold: 600;

      --tracking-tight: -0.02em;
      --tracking-wide: 0.02em;

      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --duration-fast: 120ms;
      --duration-base: 180ms;

      --focus-ring-width: 1px;
      --focus-ring-color: rgb(221 159 87 / 0.42);
      --focus-ring: 0 0 0 var(--focus-ring-width) var(--focus-ring-color);

      --topbar-height: 44px;
      --rail-width: 56px;
      --sidebar-width: 240px;
      --aside-width: clamp(280px, 32vw, 400px);

      --nav-item-height: 36px;
      --nav-item-gap: 2px;
      --nav-padding-bottom: var(--space-4);

      --bottom-tabs-height: 56px;
      --drawer-width: min(80vw, 320px);

      --required-bg: #fee2e2;
      --required-fg: #b91c1c;
      --optional-bg: #e5e7eb;
      --optional-fg: #4b5563;
      --chip-bg: #ede9fe;
      --chip-fg: #5b21b6;
    }

    :root,
    :root[data-theme="light"] {
      color-scheme: light;
      --bg-chrome:  #f9fafd;
      --bg-surface: #fcfcfc;
      --bg-hover:    rgb(221 159 87 / 0.07);
      --bg-selected: rgb(221 159 87 / 0.14);
      --text-primary:   #1c1e28;
      --text-secondary: #545862;
      --text-tertiary:  #6e7280;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        color-scheme: dark;
        --bg-chrome:  #1c1d24;
        --bg-surface: #202229;
        --bg-hover:    rgb(221 159 87 / 0.05);
        --bg-selected: rgb(221 159 87 / 0.14);
        --text-primary:   #e8e6e1;
        --text-secondary: #a8acb6;
        --text-tertiary:  #8c8f99;
        --focus-ring-color: rgb(221 159 87 / 0.5);
      }
    }

    :root[data-theme="dark"] {
      color-scheme: dark;
      --bg-chrome:  #1a1c23;
      --bg-surface: #202229;
      --bg-hover:    rgb(221 159 87 / 0.05);
      --bg-selected: rgb(221 159 87 / 0.14);
      --text-primary:   #e8e6e1;
      --text-secondary: #a8acb6;
      --text-tertiary:  #6a6e78;
      --focus-ring-color: rgb(221 159 87 / 0.5);
    }
  }

  @layer base {
    html {
      font-family: var(--font-sans);
      font-size: var(--text-base);
      line-height: var(--leading-normal);
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-surface);
      color: var(--text-primary);
      font-weight: var(--weight-regular);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    main, header, footer, nav, section, article {
      display: block;
    }

    h1, h2, h3, h4, h5, h6 {
      margin: 0;
      font-weight: var(--weight-semibold);
      line-height: var(--leading-snug);
    }

    h1 { font-size: var(--text-3xl); }
    h2 { font-size: var(--text-2xl); }
    h3 { font-size: var(--text-xl); }
    h4 { font-size: var(--text-lg); }
    h5, h6 { font-size: var(--text-base); }

    p { margin: 0; }

    a {
      color: var(--text-primary);
      text-decoration: underline;
      text-underline-offset: 2px;
      text-decoration-thickness: 1px;
    }

    a:hover { text-decoration: underline; }

    button, input, textarea, select {
      font-family: inherit;
      font-size: inherit;
    }

    button:focus-visible, a:focus-visible, input:focus-visible,
    textarea:focus-visible, select:focus-visible {
      outline: var(--focus-ring);
      outline-offset: 2px;
    }
  }

  @layer layout {
    @media (min-width: 1280px) {
      body {
        display: grid;
        grid-template-columns: var(--sidebar-width) 1fr;
        grid-template-rows: auto 1fr;
        height: 100vh;
        overflow: hidden;
      }

      nav[role="navigation"],
      aside {
        grid-row: 2;
        grid-column: 1;
        width: var(--sidebar-width);
        background-color: var(--bg-chrome);
        border-right: 1px solid var(--bg-hover);
        overflow-y: auto;
        padding: var(--space-4);
      }

      main {
        grid-row: 2;
        grid-column: 2;
        overflow-y: auto;
        padding: var(--space-8);
      }
    }

    @media (min-width: 768px) and (max-width: 1279px) {
      body {
        display: grid;
        grid-template-rows: auto auto 1fr;
        height: auto;
        min-height: 100vh;
      }

      nav[role="navigation"],
      aside {
        grid-row: 2;
        background-color: var(--bg-chrome);
        border-bottom: 1px solid var(--bg-hover);
        overflow-x: auto;
        padding: var(--space-4) var(--space-6);
        display: flex;
        gap: var(--space-4);
      }

      main {
        grid-row: 3;
        padding: var(--space-6);
        max-width: 100%;
      }
    }

    @media (max-width: 767px) {
      body {
        display: grid;
        grid-template-rows: auto 1fr auto;
        height: 100vh;
        overflow: hidden;
      }

      main {
        grid-row: 2;
        overflow-y: auto;
        padding: var(--space-4);
      }

      nav[role="navigation"],
      aside {
        grid-row: 3;
        height: var(--bottom-tabs-height);
        background-color: var(--bg-chrome);
        border-top: 1px solid var(--bg-hover);
        display: flex;
        gap: 0;
        padding: 0;
        overflow-x: auto;
      }

      nav[role="navigation"] a,
      aside a {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: var(--space-2);
        font-size: var(--text-xs);
        color: var(--text-secondary);
      }
    }
  }

   
  @layer components {
    section.scope {
      margin-block: 1.5rem;
    }
    section.scope > h2 {
      font-size: 1.15rem;
      margin: 0 0 0.25rem;
      color: var(--text-primary);
    }
    section.scope > p.scope-desc {
      margin: 0 0 0.75rem;
      color: var(--text-secondary);
      font-size: 0.9375rem;
    }
    article.type {
      margin-block: 1rem;
      border: 1px solid var(--bg-hover);
      border-radius: var(--radius-3);
      padding: 0.85rem 1rem 1rem;
      background: var(--bg-surface);
    }
    article.type > h3 {
      margin: 0 0 0.25rem;
      font-size: 1.05rem;
      color: var(--text-primary);
    }
    article.type > h3 code {
      font-family: var(--font-mono);
      background: var(--bg-hover);
      padding: 0.05rem 0.4rem;
      border-radius: var(--radius-2);
      font-size: 0.95rem;
    }
    article.type .extends {
      font-size: 0.85rem;
      color: var(--text-secondary);
      font-family: var(--font-mono);
    }
    article.type > p.type-desc {
      margin: 0.35rem 0 0.65rem;
      color: var(--text-primary);
      font-size: 0.9375rem;
    }
    table.fields {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    table.fields thead th {
      text-align: left;
      border-bottom: 1px solid var(--bg-hover);
      padding: 0.4rem 0.55rem;
      color: var(--text-secondary);
      font-weight: 600;
      font-size: 0.8125rem;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }
    table.fields tbody td {
      padding: 0.5rem 0.55rem;
      border-bottom: 1px solid var(--bg-hover);
      vertical-align: top;
    }
    table.fields tbody tr:last-child td {
      border-bottom: 0;
    }
    table.fields code {
      font-family: var(--font-mono);
      background: var(--bg-hover);
      padding: 0.05rem 0.35rem;
      border-radius: var(--radius-2);
      font-size: 0.85rem;
    }
    .pill {
      display: inline-block;
      padding: 0.1rem 0.5rem;
      border-radius: var(--radius-pill);
      font-size: 0.75rem;
      font-weight: 500;
    }
    .pill[data-key="required"][data-value="true"] {
      background: var(--required-bg);
      color: var(--required-fg);
    }
    .pill[data-key="required"][data-value="false"] {
      background: var(--optional-bg);
      color: var(--optional-fg);
    }
    .chip-list {
      display: inline-flex;
      flex-wrap: wrap;
      gap: 0.25rem;
    }
    .chip {
      display: inline-block;
      padding: 0.05rem 0.45rem;
      border-radius: var(--radius-2);
      background: var(--chip-bg);
      color: var(--chip-fg);
      font-size: 0.8rem;
      font-family: var(--font-mono);
    }
    .muted-dash {
      color: var(--text-secondary);
    }
  }
</style>
</head>
<body>
<nav class="sidebar" role="navigation" aria-label="Primary">
	<ul class="sidebar-items">
		<li>
			<a
				href="/"
				class="sidebar-item"
			>
				<span class="sidebar-item-label">Cascade Index</span>
			</a>
		</li>
		<li>
			<a
				href="/flow"
				class="sidebar-item"
			>
				<span class="sidebar-item-label">Flow</span>
			</a>
		</li>
		<li>
			<a
				href="/kanban"
				class="sidebar-item"
			>
				<span class="sidebar-item-label">Kanban</span>
			</a>
		</li>
		<li>
			<a
				href="/roadmap"
				class="sidebar-item"
			>
				<span class="sidebar-item-label">Roadmap</span>
			</a>
		</li>
		<li>
			<a
				href="/schema"
				class="sidebar-item" aria-current="page"
			>
				<span class="sidebar-item-label">Schema</span>
			</a>
		</li>
		<li>
			<form method="get" action="/search" class="sidebar-search-form">
				<input
					type="text"
					name="q"
					placeholder="Search..."
					class="sidebar-search-input"
					aria-label="Search cascade records"
				/>
			</form>
		</li>
	</ul>
</nav>

<style>
	 

	.sidebar {
		width: 100%;
		height: 100%;
		background: var(--bg-chrome);
		padding: 0 var(--space-3) var(--nav-padding-bottom);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.sidebar-items {
		display: flex;
		flex-direction: column;
		gap: var(--nav-item-gap);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.sidebar-item {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		width: 100%;
		height: var(--nav-item-height);
		padding: 0 var(--space-3);
		border-radius: var(--radius-2);
		color: var(--text-secondary);
		text-align: left;
		text-decoration: none;
		font-size: var(--text-sm);
		transition:
			background-color var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out);
	}

	.sidebar-item:hover {
		background: var(--bg-hover);
		color: var(--text-primary);
	}

	.sidebar-item[aria-current="page"] {
		background: var(--bg-selected);
		color: var(--text-primary);
		font-weight: var(--weight-medium);
	}

	.sidebar-item:focus-visible {
		outline: none;
		box-shadow: var(--focus-ring);
	}

	.sidebar-item-label {
		flex: 1;
	}

	 

	.sidebar-search-form {
		display: flex;
		width: 100%;
		height: var(--nav-item-height);
		padding: 0;
		margin: 0;
	}

	.sidebar-search-input {
		flex: 1;
		padding: 0 var(--space-3);
		border: none;
		border-radius: var(--radius-2);
		background: var(--bg-hover);
		color: var(--text-primary);
		font-size: var(--text-sm);
		font-family: inherit;
	}

	.sidebar-search-input::placeholder {
		color: var(--text-secondary);
	}

	.sidebar-search-input:focus {
		outline: none;
		box-shadow: var(--focus-ring);
		background: var(--bg-surface);
	}

	 

	@media (max-width: 1279px) {
		.sidebar-items {
			flex-direction: row;
		}

		.sidebar-item {
			flex: 1;
		}
	}

	@media (max-width: 767px) {
		.sidebar {
			padding: 0;
			gap: 0;
		}

		.sidebar-items {
			gap: 0;
		}

		.sidebar-item {
			border-radius: 0;
			padding: var(--space-2);
			height: auto;
			flex-direction: column;
			justify-content: center;
			font-size: var(--text-xs);
		}

		.sidebar-search-form {
			display: none;
		}
	}
</style>


<main aria-labelledby="schema-title">
  <header>
    <div class="meta-tag">schema browser</div>
    <h1 id="schema-title">Schema Browser</h1>
  </header>

  
  <section class="scope" aria-label="Scope cascade">
    <h2>cascade</h2>
    <p class="scope-desc">Cascade orchestration records (drops, planners, droplets, QA).</p>

    
    <article class="type" aria-label="Type drop">
      <h3><code>drop</code> <span class="extends">extends ActionItem</span></h3>
      <p class="type-desc">Top-level lane container; groups planners &#43; droplets under a single drop_NNN namespace.</p>
      <table class="fields">
        <thead>
          <tr>
            <th scope="col">name</th>
            <th scope="col">type</th>
            <th scope="col">required</th>
            <th scope="col">default</th>
            <th scope="col">enum</th>
            <th scope="col">description</th>
          </tr>
        </thead>
        <tbody>
          
          <tr>
            <td><code>drop_number</code></td>
            <td><code>string</code></td>
            <td>
              <span class="pill" data-key="required" data-value="true">required</span>
            </td>
            <td><span class="muted-dash">—</span></td>
            <td>
              <span class="muted-dash">—</span>
            </td>
            <td>Zero-padded drop sequence number, e.g. 004.</td>
          </tr>
          
          <tr>
            <td><code>structural_type</code></td>
            <td><code>string</code></td>
            <td>
              <span class="pill" data-key="required" data-value="true">required</span>
            </td>
            <td><code>drop</code></td>
            <td>
              <span class="chip-list"><span class="chip">drop</span><span class="chip">planner</span><span class="chip">droplet</span><span class="chip">qa_proof</span><span class="chip">qa_falsification</span></span>
            </td>
            <td>Discriminator for the cascade record family.</td>
          </tr>
          
          <tr>
            <td><code>irreducible</code></td>
            <td><code>boolean</code></td>
            <td>
              <span class="pill" data-key="required" data-value="false">optional</span>
            </td>
            <td><code>false</code></td>
            <td>
              <span class="muted-dash">—</span>
            </td>
            <td>Marks a drop as not further decomposable.</td>
          </tr>
          
          <tr>
            <td><code>paths</code></td>
            <td><code>array&lt;string&gt;</code></td>
            <td>
              <span class="pill" data-key="required" data-value="false">optional</span>
            </td>
            <td><span class="muted-dash">—</span></td>
            <td>
              <span class="muted-dash">—</span>
            </td>
            <td>Code paths owned by this drop. Attack payload: &lt;script&gt;alert(&#39;xss&#39;)&lt;/script&gt;</td>
          </tr>
          
        </tbody>
      </table>
    </article>
    
    <article class="type" aria-label="Type planner">
      <h3><code>planner</code> <span class="extends">extends ActionItem</span></h3>
      <p class="type-desc">Decomposition node; emits child planners or terminal droplets.</p>
      <table class="fields">
        <thead>
          <tr>
            <th scope="col">name</th>
            <th scope="col">type</th>
            <th scope="col">required</th>
            <th scope="col">default</th>
            <th scope="col">enum</th>
            <th scope="col">description</th>
          </tr>
        </thead>
        <tbody>
          
          <tr>
            <td><code>role</code></td>
            <td><code>string</code></td>
            <td>
              <span class="pill" data-key="required" data-value="true">required</span>
            </td>
            <td><code>planner</code></td>
            <td>
              <span class="chip-list"><span class="chip">planner</span></span>
            </td>
            <td>Fixed to &#39;planner&#39; for this record type.</td>
          </tr>
          
          <tr>
            <td><code>decision_log</code></td>
            <td><code>array&lt;string&gt;</code></td>
            <td>
              <span class="pill" data-key="required" data-value="false">optional</span>
            </td>
            <td><span class="muted-dash">—</span></td>
            <td>
              <span class="muted-dash">—</span>
            </td>
            <td>Ordered timeline of planner decisions.</td>
          </tr>
          
          <tr>
            <td><code>priority</code></td>
            <td><code>string</code></td>
            <td>
              <span class="pill" data-key="required" data-value="false">optional</span>
            </td>
            <td><span class="muted-dash">—</span></td>
            <td>
              <span class="chip-list"><span class="chip">low</span><span class="chip">normal</span><span class="chip">high</span></span>
            </td>
            <td><span class="muted-dash">—</span></td>
          </tr>
          
        </tbody>
      </table>
    </article>
    
  </section>
  

  <footer>
    Rendered from ta schema metadata. Track A shared-chrome template.
  </footer>
</main>
</body>
</html>
