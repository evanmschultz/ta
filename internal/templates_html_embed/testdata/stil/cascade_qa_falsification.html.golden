"19.5" data-astro-cid-vvnlysyq></line> </svg> </button> </div> </header> <main class="stil-shell-main" data-astro-cid-d2uabui7>  <article class="qa-view qa-view--falsif" aria-labelledby="qa-title" data-astro-cid-6ez3wuez> <header class="qa-header" data-astro-cid-6ez3wuez> <p class="qa-type" data-astro-cid-6ez3wuez>cascade.qa_falsification</p> <h1 id="qa-title" class="qa-title" data-astro-cid-6ez3wuez>Plan-QA falsif of L3-E3 planner — stil view set</h1> <p class="qa-id" data-astro-cid-6ez3wuez><code data-astro-cid-6ez3wuez>drop_004.drop.l3_e3_stil_views-plan-qa-falsification</code></p> <p class="qa-role-row" data-astro-cid-6ez3wuez> <span class="qa-role-label" data-astro-cid-6ez3wuez>role</span> <span class="pill pill-role pill-role--falsif" data-astro-cid-6ez3wuez>qa-falsification</span> </p> <p class="qa-target-row" data-astro-cid-6ez3wuez> <span class="qa-target-label" data-astro-cid-6ez3wuez>target_id</span> <code class="qa-target-id" data-astro-cid-6ez3wuez>drop_004.drop.l3_e3_stil_views</code> </p> </header> <section class="meta" aria-label="Record metadata" data-astro-cid-6ez3wuez> <dl class="meta-grid" data-astro-cid-6ez3wuez> <div class="meta-cell" data-astro-cid-6ez3wuez> <dt data-astro-cid-6ez3wuez>state</dt> <dd data-astro-cid-6ez3wuez> <span class="pill pill-state pill-state--complete" data-astro-cid-6ez3wuez> complete </span> </dd> </div> <div class="meta-cell" data-astro-cid-6ez3wuez> <dt data-astro-cid-6ez3wuez>outcome</dt> <dd data-astro-cid-6ez3wuez> <span class="pill pill-outcome pill-outcome--success" data-astro-cid-6ez3wuez> success </span> </dd> </div> <div class="meta-cell" data-astro-cid-6ez3wuez> <dt data-astro-cid-6ez3wuez>priority</dt> <dd data-astro-cid-6ez3wuez><code data-astro-cid-6ez3wuez>high</code></dd> </div> <div class="meta-cell meta-cell--wide" data-astro-cid-6ez3wuez> <dt data-astro-cid-6ez3wuez>parent_id</dt> <dd data-astro-cid-6ez3wuez><code data-astro-cid-6ez3wuez>drop_004.drop.l3_e3_stil_views</code></dd> </div> <div class="meta-cell" data-astro-cid-6ez3wuez> <dt data-astro-cid-6ez3wuez>created_at</dt> <dd data-astro-cid-6ez3wuez><time datetime="2026-05-15T09:00:00Z" data-astro-cid-6ez3wuez>2026-05-15T09:00:00Z</time></dd> </div> <div class="meta-cell" data-astro-cid-6ez3wuez> <dt data-astro-cid-6ez3wuez>updated_at</dt> <dd data-astro-cid-6ez3wuez><time datetime="2026-05-18T14:50:00Z" data-astro-cid-6ez3wuez>2026-05-18T14:50:00Z</time></dd> </div> <div class="meta-cell" data-astro-cid-6ez3wuez> <dt data-astro-cid-6ez3wuez>started_at</dt> <dd data-astro-cid-6ez3wuez><time datetime="2026-05-18T11:20:00Z" data-astro-cid-6ez3wuez>2026-05-18T11:20:00Z</time></dd> </div> <div class="meta-cell" data-astro-cid-6ez3wuez> <dt data-astro-cid-6ez3wuez>completed_at</dt> <dd data-astro-cid-6ez3wuez><time datetime="2026-05-18T14:50:00Z" data-astro-cid-6ez3wuez>2026-05-18T14:50:00Z</time></dd> </div> </dl> </section>  <section class="component-card" id="component-objective" data-component="objective"> <header class="component-card-header"> <span class="component-card-id">objective</span> <h2 class="component-card-name">objective</h2> <code class="component-card-path">cascade.qa_falsification.objective</code> </header> <p class="component-card-note">What this adversarial pass set out to attack.</p> <div class="component-card-stage">  <p class="prose" data-astro-cid-6ez3wuez>Attack the L3-E3 plan. Found 4 confirmed counter-examples — all folded as plan amendments before descent.</p>  </div> </section> <section class="component-card" id="component-description" data-component="description"> <header class="component-card-header"> <span class="component-card-id">description</span> <h2 class="component-card-name">description</h2> <code class="component-card-path">cascade.qa_falsification.description</code> </header> <p class="component-card-note">Long-form falsification context.</p> <div class="component-card-stage">  <p class="prose" data-astro-cid-6ez3wuez>Adversarial pass — tried to break the L3-E3 plan via hidden dependencies, YAGNI pressure, and contract drift.</p>  </div> </section>  <section class="block block--feature" aria-labelledby="decision-log-heading" data-astro-cid-6ez3wuez> <header class="block-feature-header" data-astro-cid-6ez3wuez> <h2 id="decision-log-heading" class="block-title" data-astro-cid-6ez3wuez>decision_log</h2> <span class="block-count" data-astro-cid-6ez3wuez>4 entries</span> </header> <ol class="decision-log" data-astro-cid-6ez3wuez> <li class="decision-entry decision-entry--falsif" data-astro-cid-6ez3wuez> <span class="decision-index" aria-hidden="true" data-astro-cid-6ez3wuez> 01 </span> <span class="decision-text" data-astro-cid-6ez3wuez>CE1: stil component allowlist was implicit. Folded AMEND-1: explicit allowlist {Sidebar, Topbar, NavRail, BottomTabs, ComponentCard, MailRow, Button, Swatch}.</span> </li><li class="decision-entry decision-entry--falsif" data-astro-cid-6ez3wuez> <span class="decision-index" aria-hidden="true" data-astro-cid-6ez3wuez> 02 </span> <span class="decision-text" data-astro-cid-6ez3wuez>CE2: cascade_qa was a single page mixing proof + falsification roles. Folded AMEND-2: split into cascade_qa_proof.astro + cascade_qa_falsification.astro.</span> </li><li class="decision-entry decision-entry--falsif" data-astro-cid-6ez3wuez> <span class="decision-index" aria-hidden="true" data-astro-cid-6ez3wuez> 03 </span> <span class="decision-text" data-astro-cid-6ez3wuez>CE3: bindings.json source path was ambiguous. Folded AMEND-3: pin to stil/main/src/bindings/baseline.json (source) with dist/bindings.json fallback.</span> </li><li class="decision-entry decision-entry--falsif" data-astro-cid-6ez3wuez> <span class="decision-index" aria-hidden="true" data-astro-cid-6ez3wuez> 04 </span> <span class="decision-text" data-astro-cid-6ez3wuez>CE4: stil_records.ts had no schema-snapshot freeze marker. Folded AMEND-4: verbatim header comment with 2026-05-18 snapshot date and explicit FROZEN-data guard.</span> </li> </ol> </section>  </article>  </main> </div> </div></body></html>