---
// L3-E3-D2 — cascade.planner view (stil).
//
// Renders the MOCK_PLANNER fixture as a single-record stil view. Consumes
// StilLayout in shell-chrome mode so Sidebar + Topbar provide the global
// navigation chrome at the layout layer (per AMEND-1 allowlist).
//
// The planner record's signature payload is `decision_log`, so this view
// renders the log as the focal element — a numbered <ol> timeline below
// the prose blocks. objective + description + acceptance_criteria +
// validation_plan all use ComponentCard wrappers for the prose surface.
// validation_plan is rendered when present; the fixture omits it today
// (the schema does not currently expose validation_plan on cascade.planner)
// so the section conditionally drops.
//
// AMEND-1 component allowlist honoured: only {Sidebar, Topbar,
// ComponentCard} are imported. Sidebar + Topbar come in via StilLayout's
// chrome="shell" prop, ComponentCard is imported directly.
//
// All styling rides stil's --stil-* / spacing / colour CSS custom
// properties — no hard-coded palette values, no inline styles.
//
// ZERO authored client-side script elements.

import StilLayout from "../../layouts/StilLayout.astro";
import ComponentCard from "@hylla/stil/src/components/ComponentCard.astro";
import { MOCK_PLANNER } from "../../mock/stil_records.ts";

const record = MOCK_PLANNER;

interface SidebarItem {
  icon: string;
  label: string;
  selected?: boolean;
  badge?: string;
  muted?: boolean;
}

const sidebarItems: ReadonlyArray<SidebarItem> = [
  { icon: "←", label: "Gallery" },
  { icon: "◇", label: "cascade.drop" },
  { icon: "◆", label: "cascade.planner", selected: true },
  { icon: "◇", label: "cascade.droplet", muted: true },
  { icon: "◇", label: "cascade.qa_proof", muted: true },
  { icon: "◇", label: "cascade.qa_falsification", muted: true },
  { icon: "◇", label: "roadmap.version", muted: true },
  { icon: "◇", label: "schema.browser", muted: true },
];

const decisionLog: ReadonlyArray<string> = record.decision_log ?? [];
const paths: ReadonlyArray<string> = record.paths ?? [];
const labels: ReadonlyArray<string> = record.labels ?? [];

// validation_plan is not part of the current cascade.planner schema
// surface (no field on the CascadeActionItem fixture interface), so this
// dereferences to undefined for MOCK_PLANNER and the section drops out.
// Kept as a conditional so when the schema gains the field, the view
// picks it up without further edits to this file.
const validationPlan = (record as { validation_plan?: string })
  .validation_plan;
---

<StilLayout
  title="cascade.planner view — stil"
  chrome="shell"
  sidebarTitle="stil views"
  sidebarItems={sidebarItems}
  topbarTitle="cascade.planner"
>
  <article class="planner-view" aria-labelledby="planner-title">
    <header class="planner-header">
      <p class="planner-type">cascade.planner</p>
      <h1 id="planner-title" class="planner-title">{record.title}</h1>
      <p class="planner-id"><code>{record.id}</code></p>
    </header>

    <section class="meta" aria-label="Record metadata">
      <dl class="meta-grid">
        <div class="meta-cell">
          <dt>role</dt>
          <dd><code>{record.role}</code></dd>
        </div>
        {record.structural_type && (
          <div class="meta-cell">
            <dt>structural_type</dt>
            <dd><code>{record.structural_type}</code></dd>
          </div>
        )}
        <div class="meta-cell">
          <dt>state</dt>
          <dd>
            <span class={`pill pill-state pill-state--${record.state}`}>
              {record.state}
            </span>
          </dd>
        </div>
        <div class="meta-cell">
          <dt>outcome</dt>
          <dd>
            {record.outcome ? (
              <span class={`pill pill-outcome pill-outcome--${record.outcome}`}>
                {record.outcome}
              </span>
            ) : (
              <span class="meta-empty">—</span>
            )}
          </dd>
        </div>
        {record.priority && (
          <div class="meta-cell">
            <dt>priority</dt>
            <dd><code>{record.priority}</code></dd>
          </div>
        )}
        {record.parent_id && (
          <div class="meta-cell meta-cell--wide">
            <dt>parent_id</dt>
            <dd><code>{record.parent_id}</code></dd>
          </div>
        )}
        <div class="meta-cell">
          <dt>created_at</dt>
          <dd><time datetime={record.created_at}>{record.created_at}</time></dd>
        </div>
        <div class="meta-cell">
          <dt>updated_at</dt>
          <dd><time datetime={record.updated_at}>{record.updated_at}</time></dd>
        </div>
        {record.started_at && (
          <div class="meta-cell">
            <dt>started_at</dt>
            <dd><time datetime={record.started_at}>{record.started_at}</time></dd>
          </div>
        )}
        {record.completed_at && (
          <div class="meta-cell">
            <dt>completed_at</dt>
            <dd><time datetime={record.completed_at}>{record.completed_at}</time></dd>
          </div>
        )}
      </dl>
    </section>

    {record.objective && (
      <ComponentCard
        id="objective"
        name="objective"
        source="cascade.planner.objective"
        note="What this planner sets out to decide and route."
      >
        <p class="prose">{record.objective}</p>
      </ComponentCard>
    )}

    {record.description && (
      <ComponentCard
        id="description"
        name="description"
        source="cascade.planner.description"
        note="Long-form planner context."
      >
        <p class="prose">{record.description}</p>
      </ComponentCard>
    )}

    {record.acceptance_criteria && (
      <ComponentCard
        id="acceptance"
        name="acceptance_criteria"
        source="cascade.planner.acceptance_criteria"
        note="Conditions required before this planner can close."
      >
        <pre class="criteria">{record.acceptance_criteria}</pre>
      </ComponentCard>
    )}

    {validationPlan && (
      <ComponentCard
        id="validation"
        name="validation_plan"
        source="cascade.planner.validation_plan"
        note="How this planner's output will be validated."
      >
        <pre class="criteria">{validationPlan}</pre>
      </ComponentCard>
    )}

    {decisionLog.length > 0 && (
      <section class="block block--feature" aria-labelledby="decision-log-heading">
        <header class="block-feature-header">
          <h2 id="decision-log-heading" class="block-title">decision_log</h2>
          <span class="block-count">{decisionLog.length} entries</span>
        </header>
        <ol class="decision-log" aria-describedby="decision-log-heading">
          {decisionLog.map((entry, idx) => (
            <li class="decision-entry">
              <span class="decision-index" aria-hidden="true">
                {String(idx + 1).padStart(2, "0")}
              </span>
              <span class="decision-text">{entry}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    {paths.length > 0 && (
      <section class="block" aria-labelledby="paths-heading">
        <h2 id="paths-heading" class="block-title">paths</h2>
        <ul class="paths" role="list">
          {paths.map((p) => (
            <li><code>{p}</code></li>
          ))}
        </ul>
      </section>
    )}

    {labels.length > 0 && (
      <section class="block" aria-labelledby="labels-heading">
        <h2 id="labels-heading" class="block-title">labels</h2>
        <ul class="labels" role="list">
          {labels.map((l) => (
            <li class="label-chip"><code>{l}</code></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</StilLayout>

<style>
  .planner-view {
    display: flex;
    flex-direction: column;
    gap: var(--space-6, 1.5rem);
    max-width: 880px;
  }

  .planner-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .planner-type {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .planner-title {
    font-family: var(--font-serif, ui-serif, Georgia, serif);
    font-size: var(--text-3xl, 1.875rem);
    font-weight: var(--weight-regular, 400);
    line-height: var(--leading-tight, 1.15);
    letter-spacing: var(--tracking-tight, -0.01em);
    color: var(--text-primary);
    margin: 0;
  }

  .planner-id {
    margin: 0;
    color: var(--text-secondary);
  }

  .planner-id code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-sm, 0.875rem);
  }

  .meta {
    background: var(--bg-surface);
    border-radius: var(--radius-3, 8px);
    padding: var(--space-5, 1.25rem);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-4, 1rem) var(--space-5, 1.25rem);
    margin: 0;
  }

  .meta-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-1, 0.25rem);
    min-width: 0;
  }

  .meta-cell--wide {
    grid-column: 1 / -1;
  }

  .meta-cell dt {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .meta-cell dd {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--text-sm, 0.875rem);
    word-break: break-word;
  }

  .meta-cell dd code {
    font-family: var(--font-mono, ui-monospace, monospace);
  }

  .meta-empty {
    color: var(--text-tertiary);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-2, 0.5rem);
    height: 1.4em;
    border-radius: var(--radius-2, 4px);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    font-weight: var(--weight-medium, 500);
    background: var(--bg-chrome, var(--bg-hover));
    color: var(--text-primary);
  }

  .pill-state--in_progress {
    background: var(--state-info-bg, var(--bg-hover));
    color: var(--state-info-text, var(--text-primary));
  }

  .pill-state--complete {
    background: var(--state-success-bg, var(--bg-hover));
    color: var(--state-success-text, var(--text-primary));
  }

  .pill-state--failed {
    background: var(--state-error-bg, var(--bg-hover));
    color: var(--state-error-text, var(--text-primary));
  }

  .pill-state--archived,
  .pill-state--todo {
    background: var(--bg-chrome, var(--bg-hover));
    color: var(--text-secondary);
  }

  .pill-outcome--success {
    background: var(--state-success-bg, var(--bg-hover));
    color: var(--state-success-text, var(--text-primary));
  }

  .pill-outcome--failure {
    background: var(--state-error-bg, var(--bg-hover));
    color: var(--state-error-text, var(--text-primary));
  }

  .pill-outcome--blocked {
    background: var(--state-warn-bg, var(--bg-hover));
    color: var(--state-warn-text, var(--text-primary));
  }

  .prose {
    margin: 0;
    color: var(--text-primary);
    line-height: var(--leading-relaxed, 1.6);
  }

  .criteria {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-sm, 0.875rem);
    color: var(--text-primary);
    background: var(--bg-canvas, transparent);
    padding: var(--space-3, 0.75rem);
    border-radius: var(--radius-2, 4px);
    white-space: pre-wrap;
    overflow-x: auto;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
  }

  .block--feature {
    background: var(--bg-surface);
    border-radius: var(--radius-3, 8px);
    padding: var(--space-5, 1.25rem);
  }

  .block-feature-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3, 0.75rem);
  }

  .block-title {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-sm, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin: 0;
  }

  .block-count {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .decision-log {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
  }

  .decision-entry {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3, 0.75rem);
    align-items: baseline;
    padding-left: var(--space-3, 0.75rem);
    border-left: 2px solid var(--border-subtle, rgba(0, 0, 0, 0.08));
  }

  .decision-index {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .decision-text {
    color: var(--text-primary);
    line-height: var(--leading-relaxed, 1.6);
  }

  .paths {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .paths code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-sm, 0.875rem);
    color: var(--text-primary);
  }

  .labels {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
  }

  .label-chip {
    background: var(--bg-chrome, var(--bg-hover));
    border-radius: var(--radius-2, 4px);
    padding: 0 var(--space-2, 0.5rem);
    font-size: var(--text-xs, 0.75rem);
  }

  @media (max-width: 640px) {
    .planner-title {
      font-size: var(--text-2xl, 1.5rem);
    }

    .meta-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 420px) {
    .meta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
