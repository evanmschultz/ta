---
// L3-E3-D4 — roadmap.version view (stil).
//
// Renders the MOCK_ROADMAP_VERSION fixture as a single-record stil view.
// Consumes StilLayout in shell-chrome mode so Sidebar + Topbar provide the
// global navigation chrome at the layout layer (per AMEND-1 allowlist).
//
// roadmap.version's signature payload differs from the cascade.* records:
//   - `version` lives in the record title (e.g. "v0.1.0 — MVP feature
//     completion"); the fixture encodes it directly in `title`.
//   - `vision_summary` is the primary prose — surfaced through ComponentCard
//     so the prose layer matches the rest of the substrate.
//   - `status` is a separate enum (planning / in_progress / landed / punted)
//     rendered as a pill using stil state tokens:
//       planning    → neutral (chrome bg)
//       in_progress → accent  (info bg)
//       landed      → success
//       punted      → muted   (chrome bg + secondary text)
//   - `target_date_band` renders as a subtitle directly under the title.
//
// Optional fields (rationale / scope / milestones / risks / transition_notes)
// are wired defensively — each section drops out cleanly when its field is
// absent from the current fixture. Today the fixture exposes vision_summary,
// status, target_date_band, description, labels; the rest gate via `if`.
//
// AMEND-1 component allowlist honoured: only {Sidebar, Topbar,
// ComponentCard} are imported. Sidebar + Topbar come in via StilLayout's
// chrome="shell" prop, ComponentCard is imported directly.
// FORBIDDEN components ({RightAside, MobileCommandFab, SettingsOptions,
// ThemeToggle, TokenEditor, InputStyles}) are NOT imported.
//
// All styling rides stil's --stil-* / spacing / colour CSS custom
// properties — no hard-coded palette values, no inline styles.
//
// ZERO authored client-side script elements.

import StilLayout from "../../layouts/StilLayout.astro";
import ComponentCard from "@hylla/stil/src/components/ComponentCard.astro";
import { MOCK_ROADMAP_VERSION } from "../../mock/stil_records.ts";

const record = MOCK_ROADMAP_VERSION;

interface SidebarItem {
  icon: string;
  label: string;
  selected?: boolean;
  badge?: string;
  muted?: boolean;
}

const sidebarItems: ReadonlyArray<SidebarItem> = [
  { icon: "←", label: "Gallery" },
  { icon: "◇", label: "cascade.drop", muted: true },
  { icon: "◇", label: "cascade.planner", muted: true },
  { icon: "◇", label: "cascade.droplet", muted: true },
  { icon: "◇", label: "cascade.qa_proof", muted: true },
  { icon: "◇", label: "cascade.qa_falsification", muted: true },
  { icon: "◆", label: "roadmap.version", selected: true },
  { icon: "◇", label: "schema.browser", muted: true },
];

const labels: ReadonlyArray<string> = record.labels ?? [];

// Optional gated fields not present on the current RoadmapVersion fixture
// interface. Dereferenced defensively so the section drops out cleanly when
// the field is absent, and activates automatically when the fixture (or a
// future schema-aligned shape) starts populating it.
interface RoadmapOptionalSurface {
  rationale?: string;
  scope?: string;
  transition_notes?: string;
  milestones?: ReadonlyArray<string>;
  risks?: ReadonlyArray<string>;
}

const optional = record as RoadmapOptionalSurface;
const milestones: ReadonlyArray<string> = optional.milestones ?? [];
const risks: ReadonlyArray<string> = optional.risks ?? [];

// status → pill class mapping per droplet spec.
//   planning    → neutral
//   in_progress → accent
//   landed      → success
//   punted      → muted
//
// Encoded as a const map so the relationship is auditable in one place; the
// CSS rules for `.pill-status--<key>` mirror these keys 1:1.
const statusPillClass: Readonly<Record<typeof record.status, string>> = {
  planning: "pill-status--planning",
  in_progress: "pill-status--in_progress",
  landed: "pill-status--landed",
  punted: "pill-status--punted",
};
---

<StilLayout
  title="roadmap.version view — stil"
  chrome="shell"
  sidebarTitle="stil views"
  sidebarItems={sidebarItems}
  topbarTitle="roadmap.version"
>
  <article class="version-view" aria-labelledby="version-title">
    <header class="version-header">
      <p class="version-type">roadmap.version</p>
      <h1 id="version-title" class="version-title">{record.title}</h1>
      {record.target_date_band && (
        <p class="version-band">
          <span class="version-band-label">target band</span>
          <span class="version-band-value">{record.target_date_band}</span>
        </p>
      )}
      <p class="version-id"><code>{record.id}</code></p>
      <p class="version-flags">
        <span
          class={`pill pill-status ${statusPillClass[record.status]}`}
          aria-label={`status: ${record.status}`}
        >
          {record.status}
        </span>
      </p>
    </header>

    <section class="meta" aria-label="Record metadata">
      <dl class="meta-grid">
        <div class="meta-cell">
          <dt>status</dt>
          <dd><code>{record.status}</code></dd>
        </div>
        <div class="meta-cell">
          <dt>state</dt>
          <dd>
            <span class={`pill pill-state pill-state--${record.state}`}>
              {record.state}
            </span>
          </dd>
        </div>
        {record.priority && (
          <div class="meta-cell">
            <dt>priority</dt>
            <dd><code>{record.priority}</code></dd>
          </div>
        )}
        {record.target_date_band && (
          <div class="meta-cell">
            <dt>target_date_band</dt>
            <dd><code>{record.target_date_band}</code></dd>
          </div>
        )}
        <div class="meta-cell">
          <dt>created_at</dt>
          <dd><time datetime={record.created_at}>{record.created_at}</time></dd>
        </div>
        <div class="meta-cell">
          <dt>updated_at</dt>
          <dd><time datetime={record.updated_at}>{record.updated_at}</time></dd>
        </div>
        {record.started_at && (
          <div class="meta-cell">
            <dt>started_at</dt>
            <dd><time datetime={record.started_at}>{record.started_at}</time></dd>
          </div>
        )}
        {record.completed_at && (
          <div class="meta-cell">
            <dt>completed_at</dt>
            <dd><time datetime={record.completed_at}>{record.completed_at}</time></dd>
          </div>
        )}
      </dl>
    </section>

    {record.vision_summary && (
      <ComponentCard
        id="vision-summary"
        name="vision_summary"
        source="roadmap.version.vision_summary"
        note="Primary prose for the release band — the user-facing one-liner."
      >
        <p class="prose">{record.vision_summary}</p>
      </ComponentCard>
    )}

    {record.description && (
      <ComponentCard
        id="description"
        name="description"
        source="roadmap.version.description"
        note="Long-form context for the release band."
      >
        <p class="prose">{record.description}</p>
      </ComponentCard>
    )}

    {optional.rationale && (
      <ComponentCard
        id="rationale"
        name="rationale"
        source="roadmap.version.rationale"
        note="Why this release exists — the underlying motivation."
      >
        <p class="prose">{optional.rationale}</p>
      </ComponentCard>
    )}

    {optional.scope && (
      <ComponentCard
        id="scope"
        name="scope"
        source="roadmap.version.scope"
        note="What this release explicitly includes (and excludes)."
      >
        <pre class="criteria">{optional.scope}</pre>
      </ComponentCard>
    )}

    {milestones.length > 0 && (
      <section class="block block--feature" aria-labelledby="milestones-heading">
        <header class="block-feature-header">
          <h2 id="milestones-heading" class="block-title">milestones</h2>
          <span class="block-count">{milestones.length} {milestones.length === 1 ? "milestone" : "milestones"}</span>
        </header>
        <ul class="paths" role="list">
          {milestones.map((m) => (
            <li><code>{m}</code></li>
          ))}
        </ul>
      </section>
    )}

    {risks.length > 0 && (
      <section class="block block--feature" aria-labelledby="risks-heading">
        <header class="block-feature-header">
          <h2 id="risks-heading" class="block-title">risks</h2>
          <span class="block-count">{risks.length} {risks.length === 1 ? "risk" : "risks"}</span>
        </header>
        <ul class="paths" role="list">
          {risks.map((r) => (
            <li><code>{r}</code></li>
          ))}
        </ul>
      </section>
    )}

    {optional.transition_notes && (
      <ComponentCard
        id="transition"
        name="transition_notes"
        source="roadmap.version.transition_notes"
        note="Handoff notes for the next planner / dogfood phase."
      >
        <pre class="criteria">{optional.transition_notes}</pre>
      </ComponentCard>
    )}

    {labels.length > 0 && (
      <section class="block" aria-labelledby="labels-heading">
        <h2 id="labels-heading" class="block-title">labels</h2>
        <ul class="labels" role="list">
          {labels.map((l) => (
            <li class="label-chip"><code>{l}</code></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</StilLayout>

<style>
  .version-view {
    display: flex;
    flex-direction: column;
    gap: var(--space-6, 1.5rem);
    max-width: 880px;
  }

  .version-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .version-type {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .version-title {
    font-family: var(--font-serif, ui-serif, Georgia, serif);
    font-size: var(--text-3xl, 1.875rem);
    font-weight: var(--weight-regular, 400);
    line-height: var(--leading-tight, 1.15);
    letter-spacing: var(--tracking-tight, -0.01em);
    color: var(--text-primary);
    margin: 0;
  }

  .version-band {
    display: flex;
    gap: var(--space-2, 0.5rem);
    align-items: baseline;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm, 0.875rem);
  }

  .version-band-label {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .version-band-value {
    font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--text-primary);
  }

  .version-id {
    margin: 0;
    color: var(--text-secondary);
  }

  .version-id code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-sm, 0.875rem);
  }

  .version-flags {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
  }

  .meta {
    background: var(--bg-surface);
    border-radius: var(--radius-3, 8px);
    padding: var(--space-5, 1.25rem);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: var(--space-4, 1rem) var(--space-5, 1.25rem);
    margin: 0;
  }

  .meta-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-1, 0.25rem);
    min-width: 0;
  }

  .meta-cell dt {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .meta-cell dd {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--text-sm, 0.875rem);
    word-break: break-word;
  }

  .meta-cell dd code {
    font-family: var(--font-mono, ui-monospace, monospace);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--space-2, 0.5rem);
    height: 1.4em;
    border-radius: var(--radius-2, 4px);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    font-weight: var(--weight-medium, 500);
    background: var(--bg-chrome, var(--bg-hover));
    color: var(--text-primary);
  }

  .pill-status--planning {
    background: var(--bg-chrome, var(--bg-hover));
    color: var(--text-primary);
  }

  .pill-status--in_progress {
    background: var(--state-info-bg, var(--bg-hover));
    color: var(--state-info-text, var(--text-primary));
  }

  .pill-status--landed {
    background: var(--state-success-bg, var(--bg-hover));
    color: var(--state-success-text, var(--text-primary));
  }

  .pill-status--punted {
    background: var(--bg-chrome, var(--bg-hover));
    color: var(--text-secondary);
  }

  .pill-state--in_progress {
    background: var(--state-info-bg, var(--bg-hover));
    color: var(--state-info-text, var(--text-primary));
  }

  .pill-state--complete {
    background: var(--state-success-bg, var(--bg-hover));
    color: var(--state-success-text, var(--text-primary));
  }

  .pill-state--failed {
    background: var(--state-error-bg, var(--bg-hover));
    color: var(--state-error-text, var(--text-primary));
  }

  .pill-state--archived,
  .pill-state--todo {
    background: var(--bg-chrome, var(--bg-hover));
    color: var(--text-secondary);
  }

  .prose {
    margin: 0;
    color: var(--text-primary);
    line-height: var(--leading-relaxed, 1.6);
  }

  .criteria {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-sm, 0.875rem);
    color: var(--text-primary);
    background: var(--bg-canvas, transparent);
    padding: var(--space-3, 0.75rem);
    border-radius: var(--radius-2, 4px);
    white-space: pre-wrap;
    overflow-x: auto;
  }

  .block {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
  }

  .block--feature {
    background: var(--bg-surface);
    border-radius: var(--radius-3, 8px);
    padding: var(--space-5, 1.25rem);
  }

  .block-feature-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3, 0.75rem);
  }

  .block-title {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-sm, 0.875rem);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
    margin: 0;
  }

  .block-count {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs, 0.75rem);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .paths {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .paths code {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-sm, 0.875rem);
    color: var(--text-primary);
  }

  .labels {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
  }

  .label-chip {
    background: var(--bg-chrome, var(--bg-hover));
    border-radius: var(--radius-2, 4px);
    padding: 0 var(--space-2, 0.5rem);
    font-size: var(--text-xs, 0.75rem);
  }

  @media (max-width: 640px) {
    .version-title {
      font-size: var(--text-2xl, 1.5rem);
    }

    .meta-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 420px) {
    .meta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
